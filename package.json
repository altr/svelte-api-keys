{
	"name": "svelte-api-keys",
	"description": "API Key Generation, Validation, and Rate Limiting for SvelteKit",
	"version": "0.1.8",
	"keywords": [
		"svelte",
		"sveltekit",
		"api",
		"rest",
		"keys",
		"hash",
		"security",
		"permissions",
		"generation",
		"validation",
		"rate-limit",
		"token-bucket",
		"redis",
		"firestore",
		"throttle",
		"protect"
	],
	"files": [
		"dist"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js",
			"import": "./dist/index.js"
		}
	},
	"svelte": "dist/index.js",
	"module": "dist/index.js",
	"types": "dist/index.d.ts",
	"homepage": "https://captaincodeman.github.io/svelte-api-keys/",
	"repository": {
		"type": "git",
		"url": "https://github.com/captaincodeman/svelte-api-keys.git"
	},
	"author": {
		"name": "Simon Green",
		"email": "simon@captaincodeman.com",
		"url": "https://www.captaincodeman.com/"
	},
	"license": "MIT",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"package": "tsup && publint",
		"prepublishOnly": "pnpm run package",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest",
		"test:ui": "vitest --ui",
		"lint": "prettier --check .",
		"format": "prettier --write .",
		"emulators:start": "firebase emulators:start --import ./snapshot --export-on-exit --project demo-project",
		"prepare": "npm run package"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^3.0.8",
		"@sveltejs/kit": "^2.14.0",
		"@sveltejs/vite-plugin-svelte": "5.0.3",
		"@tailwindcss/forms": "^0.5.9",
		"@tailwindcss/typography": "^0.5.15",
		"@types/node": "^20.17.10",
		"@vitest/ui": "^1.6.0",
		"autoprefixer": "^10.4.20",
		"postcss": "^8.4.49",
		"postcss-load-config": "^5.1.0",
		"prettier": "^3.4.2",
		"prettier-plugin-svelte": "^3.3.2",
		"prettier-plugin-tailwindcss": "^0.5.14",
		"publint": "^0.2.12",
		"svelte": "5.15.0",
		"svelte-check": "^3.8.6",
		"tailwindcss": "^3.4.17",
		"tslib": "^2.8.1",
		"tsup": "^8.3.5",
		"typescript": "^5.7.2",
		"vite": "^6.0.5",
		"vitest": "^1.6.0"
	},
	"dependencies": {
		"@robloche/chartjs-plugin-streaming": "^3.1.0",
		"base-x": "^4.0.0",
		"chart.js": "^4.4.7",
		"chartjs-adapter-date-fns": "^3.0.0",
		"date-fns": "^3.6.0",
		"firebase-admin": "^12.7.0",
		"redis": "^4.7.0",
		"svelte-web-storage": "^0.0.8"
	}
}
